# Copy to .env and fill in
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sakshamai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional (worker uses in-memory fallback when absent):
# REDIS_URL=redis://127.0.0.1:6379
# AI providers — failover chain: Gemini keys → Groq → OpenRouter → mock.
# Add as many as you have; if one key fails/quota-exhausts, the next is tried automatically.
GEMINI_API_KEY=
# Optional extra Gemini keys for in-provider rotation:
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
